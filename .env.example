# QUMS Attendance Bot — environment template
# COPY this file to .env and fill in. NEVER put real credentials in this file
# (it is committed to git). Real values live in .env only.

# ====== QUMS portal ======
# MULTI-USER: ye creds KHAALI chhodo! Har user apna QID/password /qums-setup
# page se khud daalta hai (DB me AES-256-GCM encrypted save hota hai). Ye sirf
# purane single-user CLI fallback (node src/scraper.js standalone) ke liye hain.
QUMS_QID=
QUMS_PASSWORD=
QUMS_LOGIN_URL=https://qums.quantumuniversity.edu.in/
QUMS_DASHBOARD_URL=https://qums.quantumuniversity.edu.in/Web_StudentAcademic/Cyborg_S_Dashboard
QUMS_TIMETABLE_URL=https://qums.quantumuniversity.edu.in/Web_StudentAcademic/Cyborg_StudentTimeTable?id=Time%20Table

# Attendance math fallback: used ONLY if the portal API doesn't return exact counts
ATTENDANCE_TOTAL_CLASSES=40

# Year/Sem override for the attendance API (auto-detected; set only if detection fails)
#QUMS_CURRENT_YEARSEM=5

# Express server port.
# NOTE: Render pe PORT environment variable khud inject hota hai — use manually
# set karne ki zaroorat NAHI. Ye sirf local development ke liye hai.
# Server fallback (jab PORT unset ho): 10000.
PORT=3000

# Runtime environment.
# Local dev: isse hata do ya "development" rakho.
# Production (Render): NODE_ENV=production set karo (Render Dashboard → Environment).
# Render automatically RENDER=true bhi set karta hai — prod detection dono se hoti hai.
#NODE_ENV=production

# Public base URL — forgot-password reset links isi se bante hain.
# LOCAL: http://localhost:3000 (ya jis port pe chalao)
# RENDER (PRODUCTION): https://attendence-tracker-d7c4.onrender.com
# Fallback order (src/server.js): APP_BASE_URL → RENDER_EXTERNAL_URL → localhost:<PORT>
# Trailing "/" apne aap strip ho jata hai.
APP_BASE_URL=http://localhost:3000

# Real-time watcher: poll interval (minutes) during college hours (08:30-17:00 IST).
# QUMS pe webhook/push NAHI hai — ye NEAR-REAL-TIME polling hai (har N min check,
# teacher mark karte hi ~N min ke andar Telegram update). 2 min = fastest practical.
WATCH_INTERVAL_MINUTES=2

# Month Register (backdated attendance) poll interval in minutes — 24x7 loop.
# User ko near-real-time updates chahiye (backdated/evening marks bhi) — 5 min accha hai.
MONTH_REGISTER_INTERVAL_MINUTES=5

# ====== Telegram (notifications — WhatsApp channel hata diya gaya hai) ======
# BotFather se token le ke yahan daalo (e.g. 123456789:AAE...). Iske bina
# server chalega par notifications skip hongi.
TELEGRAM_BOT_TOKEN=
# Bot username (bina @) — deep-link https://t.me/<username>?start=<code> isi se banta hai
TELEGRAM_BOT_USERNAME=qums_attendance_bot

# ====== security secrets (REQUIRED for multi-user server — generate your own!) ======
# QUMS password encryption key (AES-256-GCM, base64):
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
# Kabhi change mat karna — warna saved QUMS passwords decrypt nahi honge.
ENCRYPTION_KEY=
# App session secret (hex):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Change karne pe sab users logout ho jate hain. PRODUCTION me REQUIRED —
# missing hone pe server warn karta hai (insecure dev fallback use hota hai).
SESSION_SECRET=

# ====== Email — forgot-password (Resend RECOMMENDED, SMTP fallback) ======
# resend.com → API Keys → "Create API Key" (re_...) → yahan paste karo.
# Priority: RESEND_API_KEY set hai to SMTP IGNORE hota hai.
# FREE TIER NOTE: default from (onboarding@resend.dev) se mail sirf APNE khud ke
# Resend account wale email pe jaayega. Production: Resend → Domains → verify.
RESEND_API_KEY=
# From header (verified domain hona chahiye; blank = onboarding@resend.dev)
#RESEND_FROM=QUMS Attendance Bot <noreply@yourdomain.com>

# ====== OPTIONAL: SMTP fallback for forgot-password emails (bina RESEND_API_KEY
# aur SMTP ke reset link local dev me server console me print hota hai) ======
# LOCAL: bina iske reset link server console me print hota hai.
# PRODUCTION (Render): strongly recommended — bina SMTP ke reset link kisi ko
# deliver nahi hoga (security ke liye prod logs me link print NAHI hota).
#
# GMAIL setup (sabse aasan):
#   1. Google account me 2-Step Verification ON karo
#   2. https://myaccount.google.com/apppasswords -> "App password" banao (16 chars)
#      (normal Gmail password KAAM NAHI KAREGA — sirf App Password chalega)
#   3. Neeche values bharo:
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=tumhari@gmail.com
#SMTP_PASS=abcd efgh ijkl mnop   <- Gmail App Password (spaces ke saath ya bina)
#SMTP_FROM=tumhari@gmail.com
